    "account.analytics.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps improve video quality. It is only sent if you turn it on, it turns off when you sign out, and you can change it any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar la calidad del vídeo. Solo se envía si la activas, se desactiva al cerrar sesión y puedes cambiarla cuando quieras."
          }
        }
      }
    },
